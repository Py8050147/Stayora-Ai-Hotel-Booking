// use prisma-8

// Stayora - Hotel Booking Platform
// Prisma ORM 8 contract (PostgreSQL), based on ERD V1

// ============================================================
// ENUMS (stored as text)
// ============================================================
enum UserRole {
  CUSTOMER
  HOTEL_OWNER
  HOTEL_MANAGER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum HotelStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  REJECTED
  SUSPENDED
}

enum BedType {
  SINGLE
  DOUBLE
  QUEEN
  KING
  TWIN
  BUNK
}

enum BookingStatus {
  PENDING
  PAYMENT_PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  REFUNDED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  HIDDEN
  REJECTED
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum CouponStatus {
  DRAFT
  ACTIVE
  EXPIRED
  DISABLED
}

enum NotificationType {
  BOOKING
  PAYMENT
  CANCELLATION
  REFUND
  PROMOTION
  SYSTEM
}

// ============================================================
// USERS
// ============================================================
model User {
  id            Uuid                       @id @default(uuid())
  clerkId       String?                    @unique @map("clerk_id")
  name          String
  email         String                     @unique
  phone         String?                    @unique
  passwordHash  String?                    @map("password_hash")
  role          UserRole                   @default(CUSTOMER)
  status        UserStatus                 @default(ACTIVE)
  createdAt     TimestamptzJsDate          @default(now()) @map("created_at")
  updatedAt     temporal.updatedAtJsDate() @map("updated_at")

  hotels        Hotel[]
  bookings      Booking[]
  payments      Payment[]
  reviews       Review[]
  favorites     Favorite[]
  notifications Notification[]

  @@index([role])
  @@index([status])
  @@map("users")
}

// ============================================================
// HOTELS & PROPERTY DATA
// ============================================================
model Hotel {
  id           Uuid                       @id @default(uuid())
  ownerId      Uuid                       @map("owner_id")
  name         String
  slug         String                     @unique
  description  String?
  starRating   Int?                       @map("star_rating")
  status       HotelStatus                @default(DRAFT)
  checkInTime  String                     @default("14:00") @map("check_in_time")
  checkOutTime String                     @default("11:00") @map("check_out_time")
  createdAt    TimestamptzJsDate          @default(now()) @map("created_at")
  updatedAt    temporal.updatedAtJsDate() @map("updated_at")

  owner        User                       @relation(fields: [ownerId], references: [id])
  address      Address?
  images       HotelImage[]
  amenities    HotelAmenity[]
  roomTypes    RoomType[]
  bookings     Booking[]
  reviews      Review[]
  favorites    Favorite[]

  @@index([ownerId])
  @@index([status])
  @@map("hotels")
}

model Address {
  id          Uuid           @id @default(uuid())
  hotelId     Uuid           @unique @map("hotel_id")
  addressLine String         @map("address_line")
  city        String
  state       String
  country     String
  postalCode  String         @map("postal_code")
  latitude    Numeric(9, 6)?
  longitude   Numeric(9, 6)?

  hotel       Hotel          @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@index([city])
  @@index([state])
  @@index([country])
  @@map("addresses")
}

model HotelImage {
  id        Uuid    @id @default(uuid())
  hotelId   Uuid    @map("hotel_id")
  imageUrl  String  @map("image_url")
  sortOrder Int     @default(0) @map("sort_order")
  isPrimary Boolean @default(false) @map("is_primary")

  hotel     Hotel   @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@index([hotelId, sortOrder])
  @@map("hotel_images")
}

model Amenity {
  id       Uuid           @id @default(uuid())
  name     String         @unique
  category String?

  hotels   HotelAmenity[]

  @@map("amenities")
}

// Junction table: Hotel <-> Amenity (many-to-many)
model HotelAmenity {
  hotelId   Uuid    @map("hotel_id")
  amenityId Uuid    @map("amenity_id")

  hotel     Hotel   @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  amenity   Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([hotelId, amenityId])
  @@index([amenityId])
  @@map("hotel_amenities")
}

// ============================================================
// ROOMS & INVENTORY
// ============================================================
model RoomType {
  id           Uuid            @id @default(uuid())
  hotelId      Uuid            @map("hotel_id")
  name         String
  description  String?
  maxAdults    Int             @default(2) @map("max_adults")
  maxChildren  Int             @default(0) @map("max_children")
  bedType      BedType         @map("bed_type")
  totalRooms   Int             @map("total_rooms")
  basePrice    Numeric(10, 2)  @map("base_price")

  hotel        Hotel           @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  inventory    RoomInventory[]
  bookingRooms BookingRoom[]

  @@index([hotelId])
  @@map("room_types")
}

// Daily availability and price
model RoomInventory {
  id             Uuid           @id @default(uuid())
  roomTypeId     Uuid           @map("room_type_id")
  date           DateString
  availableRooms Int            @map("available_rooms")
  price          Numeric(10, 2)
  isClosed       Boolean        @default(false) @map("is_closed")

  roomType       RoomType       @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@unique([roomTypeId, date])
  @@index([date])
  @@map("room_inventory")
}

// ============================================================
// BOOKINGS
// ============================================================
model Booking {
  id            Uuid                       @id @default(uuid())
  bookingNumber String                     @unique @map("booking_number")
  userId        Uuid                       @map("user_id")
  hotelId       Uuid                       @map("hotel_id")
  couponId      Uuid?                      @map("coupon_id")
  checkIn       DateString                 @map("check_in")
  checkOut      DateString                 @map("check_out")
  adults        Int                        @default(1)
  children      Int                        @default(0)
  rooms         Int                        @default(1)
  subtotal      Numeric(10, 2)
  tax           Numeric(10, 2)             @default(0)
  discount      Numeric(10, 2)             @default(0)
  totalAmount   Numeric(10, 2)             @map("total_amount")
  status        BookingStatus              @default(PENDING)
  paymentStatus PaymentStatus              @default(PENDING) @map("payment_status")
  holdExpiresAt TimestamptzJsDate?         @map("hold_expires_at")
  cancelledAt   TimestamptzJsDate?         @map("cancelled_at")
  cancelReason  String?                    @map("cancel_reason")
  createdAt     TimestamptzJsDate          @default(now()) @map("created_at")
  updatedAt     temporal.updatedAtJsDate() @map("updated_at")

  user          User                       @relation(fields: [userId], references: [id])
  hotel         Hotel                      @relation(fields: [hotelId], references: [id])
  coupon        Coupon?                    @relation(fields: [couponId], references: [id])
  roomLines     BookingRoom[]
  payments      Payment[]
  review        Review?

  @@index([userId])
  @@index([hotelId, checkIn, checkOut])
  @@index([status])
  @@index([status, holdExpiresAt])
  @@map("bookings")
}

// Reserved room lines. Price is snapshotted here so old bookings never change.
model BookingRoom {
  id            Uuid           @id @default(uuid())
  bookingId     Uuid           @map("booking_id")
  roomTypeId    Uuid           @map("room_type_id")
  quantity      Int
  pricePerNight Numeric(10, 2) @map("price_per_night")
  nights        Int
  subtotal      Numeric(10, 2)

  booking       Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  roomType      RoomType       @relation(fields: [roomTypeId], references: [id])

  @@index([bookingId])
  @@index([roomTypeId])
  @@map("booking_rooms")
}

// ============================================================
// PAYMENTS & REFUNDS
// ============================================================
model Payment {
  id            Uuid                       @id @default(uuid())
  bookingId     Uuid                       @map("booking_id")
  userId        Uuid                       @map("user_id")
  provider      String
  orderId       String                     @map("order_id")
  transactionId String?                    @unique @map("transaction_id")
  amount        Numeric(10, 2)
  currency      String                     @default("INR")
  status        PaymentStatus              @default(PENDING)
  paidAt        TimestamptzJsDate?         @map("paid_at")
  createdAt     TimestamptzJsDate          @default(now()) @map("created_at")
  updatedAt     temporal.updatedAtJsDate() @map("updated_at")

  booking       Booking                    @relation(fields: [bookingId], references: [id])
  user          User                       @relation(fields: [userId], references: [id])
  refunds       Refund[]

  @@unique([provider, orderId])
  @@index([bookingId])
  @@index([userId])
  @@index([status])
  @@map("payments")
}

model Refund {
  id         Uuid               @id @default(uuid())
  paymentId  Uuid               @map("payment_id")
  amount     Numeric(10, 2)
  reason     String?
  providerId String?            @unique @map("provider_id")
  status     String             @default("PENDING")
  createdAt  TimestamptzJsDate  @default(now()) @map("created_at")
  refundedAt TimestamptzJsDate? @map("refunded_at")

  payment    Payment            @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
  @@map("refunds")
}

// ============================================================
// ENGAGEMENT
// ============================================================
model Review {
  id        Uuid              @id @default(uuid())
  userId    Uuid              @map("user_id")
  hotelId   Uuid              @map("hotel_id")
  bookingId Uuid              @unique @map("booking_id")
  rating    Int
  comment   String?
  status    ReviewStatus      @default(PENDING)
  createdAt TimestamptzJsDate @default(now()) @map("created_at")

  user      User              @relation(fields: [userId], references: [id])
  hotel     Hotel             @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  booking   Booking           @relation(fields: [bookingId], references: [id])

  @@index([hotelId, status])
  @@index([userId])
  @@map("reviews")
}

model Favorite {
  id        Uuid              @id @default(uuid())
  userId    Uuid              @map("user_id")
  hotelId   Uuid              @map("hotel_id")
  createdAt TimestamptzJsDate @default(now()) @map("created_at")

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  hotel     Hotel             @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@unique([userId, hotelId])
  @@index([hotelId])
  @@map("favorites")
}

model Coupon {
  id            Uuid              @id @default(uuid())
  code          String            @unique
  discountType  DiscountType      @map("discount_type")
  discountValue Numeric(10, 2)    @map("discount_value")
  validFrom     TimestamptzJsDate @map("valid_from")
  validTo       TimestamptzJsDate @map("valid_to")
  usageLimit    Int?              @map("usage_limit")
  usedCount     Int               @default(0) @map("used_count")
  status        CouponStatus      @default(DRAFT)

  bookings      Booking[]

  @@index([status, validFrom, validTo])
  @@map("coupons")
}

model Notification {
  id        Uuid               @id @default(uuid())
  userId    Uuid               @map("user_id")
  type      NotificationType
  title     String
  message   String
  readAt    TimestamptzJsDate? @map("read_at")
  createdAt TimestamptzJsDate  @default(now()) @map("created_at")

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@map("notifications")
}
